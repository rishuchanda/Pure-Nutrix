<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Set index.php as the default directory index
  DirectoryIndex index.php index.html

  RewriteRule ^index\.php$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.php [L]
</IfModule>
