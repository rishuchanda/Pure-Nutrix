  "nodes": [
    {
      "id": "55f001b8-73ac-5410-83a6-b2c2e9add359",
      "name": "Har 3 ghante",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        200
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "15 */3 * * *"
            }
          ]
        }
      }
    },
    {
