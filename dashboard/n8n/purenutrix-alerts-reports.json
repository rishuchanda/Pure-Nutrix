      "name": "Naye alerts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        200
      ],
      "parameters": {
        "method": "GET",
        "url": "https://dashboard.purenutrix.in/api/agent/alerts",
        "options": {
          "timeout": 600000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "pnDashboardTok1",
          "name": "PureNutrix Dashboard"
        }
      }
    },
    {
      "id": "61da012e-f8c8-50aa-8064-bd5d2c95d215",
      "name": "Koi alert hai?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        200
      ],
      "parameters": {
        "jsCode": "const a = $input.first().json;\nif (!a.count) return [];           // koi naya alert nahi -> kuch mat bhejo\nreturn [{ json: a }];"
      }
    },
    {
      "id": "324a0713-b648-5750-a554-312eb7c5ec5c",
      "name": "Alert bhejo",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1020,
        200
      ],
      "parameters": {
        "chatId": "APNA_TELEGRAM_CHAT_ID",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "pnTelegramBot01",
          "name": "PureNutrix Telegram Bot"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
