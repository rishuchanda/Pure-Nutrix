        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ config: $('Listings jodo').first().json.amazon }) }}"
      },
      "executeOnce": true,
      "onError": "continueRegularOutput",
      "alwaysOutputData": true,
