    {
      "id": "bc35772f-71af-5d87-a7e7-94c78d618043",
      "name": "Reports download karo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:3100/reports",
        "options": {
          "timeout": 3600000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ mode: \"daily\" }) }}"
      },
      "executeOnce": true,
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "id": "a09d1f03-5665-596e-966e-781f4d2d5f7d",
      "name": "Pages ki list",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "jsCode": "// Kal ka din (IST) aur har platform ke pages. URL badle to yahan theek karo.\nconst d = new Date(Date.now() + 5.5 * 3600 * 1000 - 24 * 3600 * 1000);\nconst day = d.toISOString().slice(0, 10);\nconst PAGES = {\n  \"amazon\": [],\n  \"flipkart\": [\n    {\n      \"page_kind\": \"ads\",\n      \"url\": \"https://seller.flipkart.com/index.html#dashboard/ads/campaigns\"\n    }\n  ],\n  \"meesho\": []\n};\nconst out = { day };\nfor (const [platform, pages] of Object.entries(PAGES)) {\n  out[platform] = { platform, day, wait_ms: 3000, pages };\n}\nreturn [{ json: out }];"
      }
    },
    {
      "id": "7e573563-6e0c-58b9-83b7-d17b53a45cc9",
      "name": "Dashboard: kya pehle se hai",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://dashboard.purenutrix.in/api/agent/snapshot?day={{ $json.day }}",
        "options": {
          "timeout": 3600000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "executeOnce": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "pnDashboardTok1",
          "name": "PureNutrix Dashboard"
        }
      }
    },
    {
      "id": "1d4a9dbe-632b-5acb-bb13-d9230b5667ce",
      "name": "Listings jodo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "jsCode": "// Apni listing (rating) aur competitor (price) ke URL dashboard se aate hain.\nconst snap = $input.first().json;\nconst cfg = $('Pages ki list').first().json;\nconst pages = (snap.listings || []).filter(l => l.url).map(l => ({ page_kind: 'listing', url: l.url, listing_id: l.id }));\nreturn [{ json: { ...cfg, listings: { platform: 'listings', day: cfg.day, wait_ms: 2000, pages } } }];"
      }
    },
