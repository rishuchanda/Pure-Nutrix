    {
      "id": "9c87eee1-cfcf-5343-91f6-4f6c6fd4b5a9",
      "name": "Message banao",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3120,
        300
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst rep = $('Reports download karo').first().json || {};\nconst lines = ['🤖 PureNutrix — roz ki jaanch'];\nfor (const x of rep.results || []) {\n  if (x.status === 'ok') lines.push(`✓ ${x.job}: ${x.rows} rows`);\n  else if (x.status === 'error') lines.push(`⚠ ${x.job}: ${x.note}`);\n}\nif (rep.error) lines.push('⚠ Reports: ' + rep.error);\nlines.push(r.summary || '');\nif (r.alerts && r.alerts.count) lines.push('', r.alerts.text);\nreturn [{ json: { text: lines.join('\\n').slice(0, 4000), ids: (r.alerts && r.alerts.ids) || [] } }];"
      }
    },
    {
      "id": "0ae461a0-6668-53b0-8e14-8830c5454bdd",
